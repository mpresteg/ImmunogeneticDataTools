<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.nmdp.validation</groupId>
    <artifactId>ld-multimodule</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>hla-report-extraction</artifactId>
  <packaging>jar</packaging>
  <name>hla-report-extraction</name>

  <properties>
    <maven.compiler.source>${java.version}</maven.compiler.source>
    <maven.compiler.target>${java.version}</maven.compiler.target>
    <maven.enforcer.jdk-version>[${java.version},)</maven.enforcer.jdk-version>
    <maven.enforcer.maven-version>[3.0.4,)</maven.enforcer.maven-version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.build.targetEncoding>UTF-8</project.build.targetEncoding>
  </properties>

  <!-- ld-validation: so far only used for its Locus enum (candidate-line detection,
       issue #43, recognizes/cross-checks locus labels via it). Not yet used for GL
       String construction, but the module README already commits to reusing
       GLStringUtilities/GLStringConstants for that once candidate-line-detection
       produces something worth converting, rather than reinventing GL String syntax.

       pdfbox: text-layer extraction is this module's primary path (see the module README's
       "Guiding principles": prefer the embedded text layer, OCR only as a fallback for
       scanned pages, and nothing cloud-based/VLM-based in the default path, since real
       reports carry real patient PHI). OCR fallback (e.g. Tess4J) intentionally not added
       yet: none of the three real samples obtained so far need it, all have a real text
       layer, so there's nothing to test an OCR path against yet. -->
  <dependencies>
    <dependency>
      <groupId>org.nmdp.validation</groupId>
      <artifactId>ld-validation</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>3.0.8</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Just appassembler, not the full ld-tools packaging trio (also
           maven-assembly-plugin + jdeb there for a shippable tar.gz/.deb
           distribution): this module isn't at that maturity yet (one lab format
           supported, no GL String output, no validation gate). This alone is enough to
           get a runnable `target/appassembler/bin/detect-hla-report` script for
           manually trying a real PDF against whatever detectors currently exist, which
           is genuinely useful today; a full distribution isn't, yet. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>appassembler-maven-plugin</artifactId>
        <version>2.1.0</version>
        <configuration>
          <repositoryLayout>flat</repositoryLayout>
          <repositoryName>lib</repositoryName>
          <installBooterArtifacts>false</installBooterArtifacts>
          <programs>
            <program>
              <id>detect-hla-report</id>
              <mainClass>org.nmdp.hlareport.cli.DetectHlaReport</mainClass>
            </program>
          </programs>
        </configuration>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>assemble</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
